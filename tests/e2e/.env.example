# The XNAT instance under test, running a dicom-query-retrieve build from the
# develop branch, with a PACS holding the Disco fixture studies.
XNAT_URL=https://xnat.example.org

# A site administrator account.
ADMIN_USER=admin
ADMIN_PASS=

# Test accounts. Global setup creates any that do not exist, using these
# passwords, and gives DQR_ROLE_USER the DQR Access role. Choose passwords that
# exist only for these accounts.
DQR_ROLE_USER=e2edqrrole
DQR_ROLE_USER_PASS=
NO_DQR_USER=e2enodqr
NO_DQR_USER_PASS=
READONLY_USER=e2edqrreadonly
READONLY_USER_PASS=

# The PACS to search and retrieve from, by label, and the XNAT receiver it
# sends to. The receiver must use the dqrObjectIdentifier with custom
# processing on, and the PACS must know it as a move destination.
DQR_PACS_LABEL=ORTHANC
DQR_RECEIVER_AE=XDQR
DQR_RECEIVER_PORT=8104

# Which branch of the plugin is deployed. develop until the current work merges.
TARGET_BRANCH=develop
