<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="dqr" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <append>false</append>
        <file>${xnat.home}/logs/dqr.log</file>
        <encoder>
            <pattern>%d [%t] %-5p %c - %m%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${xnat.home}/logs/dqr.log.%d{yyyy-MM-dd}</fileNamePattern>
        </rollingPolicy>
    </appender>
    <logger name="org.nrg.dqr" additivity="false" level="INFO">
        <appender-ref ref="dqr"/>
    </logger>
    <logger name="org.nrg.xnatx.dqr.preferences" additivity="false" level="DEBUG">
        <appender-ref ref="dqr"/>
    </logger>
</configuration>
