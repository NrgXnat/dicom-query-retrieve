#if($item.canEdit($user))
    #* @vtlvariable name="om" type="org.nrg.xdat.om.XnatImagesessiondata" *#
    #* @vtlvariable name="link" type="org.apache.turbine.util.template.TemplateLink" *#
    <!-- BEGIN /templates/screens/xnat_imageSessionData/actionsBox/SendToPacs.vm -->
    <!-- Sequence: 20 -->
    #set($destination = $link.setPage("ExportSessionToPacs.vm").addQueryData("sessionId", $om.id))
    </ul>
    <ul>
    <li class="yuimenuitem">
        <a href="$destination")" id="sendToPacs">Send to PACS</a>
    </li>

    <script>
        $('#sendToPacs').on('click',function(e){
            e.preventDefault();
            var destination = $(this).prop('href');

            function noPacsErrorMsg(){
                XNAT.ui.dialog.open({
                    title: 'Cannot Send To DICOM Destination',
                    width: 400,
                    content: spawn('p',[
                        spawn('strong','Error:'),
                        spawn('span',' Cannot send to PACS. Either no DICOM AE connections have been enabled on this XNAT instance or none of the configured connections can be sent to. Please contact your XNAT Administrator to resolve this.')
                    ]),
                    buttons: [
                        {
                            label: 'OK',
                            isDefault: true,
                            close: true
                        }
                    ]
                });
            }

            XNAT.xhr.getJSON({
                url: XNAT.url.rootUrl('/data/pacs?storable=true')
            })
                    .success(function(data){
                        if (data.ResultSet.Result.length > 0) {
                            window.location.assign(destination);
                        } else {
                            noPacsErrorMsg();
                        }
                    })
                    .fail(function(){
                        noPacsErrorMsg();
                    })
        });
    </script>
    <!-- END /templates/screens/xnat_imageSessionData/actionsBox/SendToPacs.vm -->
#else
</ul>
    <ul>
        <li class="yuimenuitem">
            <a href="#">Can't send to pacs</a>
        </li>
#end

