#* @vtlvariable name="message" type="java.lang.String" *#
#* @vtlvariable name="content" type="org.apache.turbine.services.pull.tools.ContentTool" *#
#* @vtlvariable name="link" type="org.apache.turbine.util.template.TemplateLink" *#
#* @vtlvariable name="pacsList" type="java.util.List" *#
#* @vtlvariable name="pacs" type="org.nrg.dqr.domain.entities.Pacs" *#
#* @vtlvariable name="session" type="org.nrg.xdat.om.XnatMrsessiondata" *#
#* @vtlvariable name="scans" type="java.util.List" *#
#* @vtlvariable name="scan" type="org.nrg.xdat.model.XnatImagescandataI" *#
<!-- BEGIN templates/screens/dqr/ExportSessionToPacs.vm -->
#set ($SITE_ROOT = $content.getURI(''))

<link rel="stylesheet" type="text/css" href="https://ajax.aspnetcdn.com/ajax/jquery.dataTables/1.9.4/css/jquery.dataTables.css">
<script type="text/javascript" charset="utf8" src="https://ajax.aspnetcdn.com/ajax/jquery.dataTables/1.9.4/jquery.dataTables.min.js"></script>

<style type="text/css">
    .label-container,
    .input-container { display: inline-block; vertical-align: top; }
    .friendlyForm label { text-transform: none; }
    .xnat-table tr.disabled {
        background-color: #f0f0f0;
        color: #a8a8a8;
    }
</style>

<h2 class="edit_title" style="text-transform: capitalize">Export ${displayManager.getSingularDisplayNameForSubject()} ${displayManager.getSingularDisplayNameForImageSession()} $session.label to PACS</h2>

#if($message)
    <div class="error">$message</div>
#else

    <form id="editPacsForm" name="editPacsForm" class="friendlyForm" method="POST" action="$link.setAction("ExportSessionToPacs")">
        <div style="display: inline-block; margin-right: 8%; vertical-align: top; width: 30%;">
            <div style="margin-bottom: 4em;">
                <h4>Set Destination (Required)</h4>
                <p>
                    <label for="pacsId">Select DICOM Destination to Export To:</label>
                    <select id="pacsId" name="pacsId">
                        #foreach($pacs in $pacsList)
                            #if($pacs.queryRetrievePort)
                                #if($pacs.isDefaultStoragePacs())
                                    #set($selected = " selected")
                                #else
                                    #set($selected = "")
                                #end
                                <option value="$pacs.id"$selected>$pacs.aeTitle:$pacs.queryRetrievePort ($pacs.host)</option>
                            #end
                        #end
                    </select>
                </p>
                <input type="hidden" id="session" name="session" value="$session.id"/>
            </div>
            <div>
                <h4 style="text-transform: capitalize">${displayManager.getSingularDisplayNameForSubject()} ${displayManager.getSingularDisplayNameForImageSession()} Info</h4>
                <table id="studyInfoTable" class="xnat-table alt1 condensed" width="100%">
                    <tr>
                        <th>${displayManager.getSingularDisplayNameForSubject()}:</th>
                        <td id="patientName">$!session.dcmpatientname</td>
                    </tr>
                    <tr>
                        <th>${displayManager.getSingularDisplayNameForImageSession()} Date:</th>
                        <td>$!session.getDate()</td>
                    </tr>
                    <tr>
                        <th>${displayManager.getSingularDisplayNameForImageSession()} Label: </th>
                        <td><a href="$!{SITE_ROOT}/REST/experiments/$session.id?format=html">$!session.label</a></td>
                    </tr>
                </table>
            </div>
        </div>

        <div style="display: inline-block; vertical-align: top; width: 60%;">
            <h4>Select Scan Series to Send (Required)</h4>

            <table id="scansToExport" class="xnat-table condensed" width="100%">
                <thead>
                    <tr>
                        <th><input type="checkbox" id="selectAll" title="Select / Deselect All" /></th>
                        <th>Series</th>
                        <th>Description</th>
                        <th>Sequence</th>
                        <th>Scan Date</th>
                    </tr>
                </thead>
                <tbody>
                #set($scanCounter =0)
                #foreach($scan in $scans)
                    ## <tr class="#if($scanCounter%2 > 0) odd #else even #end">
                    <tr #if($session.getProperty("date") == $scan.getProperty("start_date")) class="original" #else class="modified" #end>
                        <td><input type="checkbox" id="scan-$!scan.id" name="scansToExport" value="$!scan.id" /></td>
                        <td class="scan-id">$!scan.id</td>
                        <td>$!scan.seriesDescription</td>
                        #set($scanType = $!scan.xSIType)
                        #if($scanType == "xnat:mrScanData" && $!scan.getProperty("parameters.sequence"))
                            <td>$!scan.getProperty("parameters.sequence")</td>
                        #else
                            <td>$!scan.getType()</td>
                        #end
                        <td>$!scan.getProperty("start_date")</td>
                    </tr>
                    #set($scanCounter = $scanCounter +1)
                #end
                </tbody>
            </table>

            <div id="scan-exclusion-warning" #if(${siteConfig.dqrPushPreference} == "true") class="hidden alert" #else class="alert" #end>
                <em>Scans that were a part of the originally imported session have been excluded.</em>
            </div>

            <p>
                <label><input id="dqrPushSetting" type="checkbox" #if(${siteConfig.dqrPushPreference} == "true") checked #end /> Enable original scans to be sent</label>
            </p>
            <p><button id="submitScansToPacs" class="btn1">Send Selected Series to PACS</button></p>
        </div>
    </form>

    <script src="$content.getURI("/scripts/dqr/SendToPacs.js")"></script>
    <script>
        console.log('exportSessionToPacs.vm');
        var enableAllScans = '${siteConfig.dqrPushPreference}';

        $(document).ready(function(){
            // clean up display of patient name
            var patientName = $('#patientName').html().replace(/\^/g,' ');
            patientName = patientName.replace(' ',', '); // add a comma after the first listed name
            $('#patientName').html(patientName);

            // Find original scans and toggle selectability if necessary
            if (enableAllScans.toLowerCase() !== 'true') {
                XNAT.app.disableOriginalScans();
            }
        });
    </script>
#end
<!-- END templates/screens/dqr/ExportSessionToPacs.vm -->
