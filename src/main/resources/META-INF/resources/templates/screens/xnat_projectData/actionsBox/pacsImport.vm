#set ($SITE_ROOT = $content.getURI(""))
#set ($projectId = $project.getId())
#set ($userHelper = $data.getSession().getAttribute("userHelper"))
#if (($userHelper.canEdit("xnat:subjectData/project", $projectId) && ($user.checkRole("Dqr") || $dqrPreferences.getAllowAllUsersToUseDqr())) || $user.checkRole("Administrator"))
<li id="import-from-pacs-action" class="yuimenuitem hidden">
    <a class="yuimenuitemlabel" href="${SITE_ROOT}/app/template/Page.vm?view=dqr/import&project=${projectId}">Import From PACS</a>
</li>
<script>
    (function(){
        const importActionItem = $('#import-from-pacs-action');
        XNAT.xhr.get({
            url: XNAT.url.rootUrl('/xapi/dqr/isDqrProject/$!{projectId}'),
            success: function(data){
                if (/^true$/i.test(data)) {
                    importActionItem.removeClass('hidden').show();
                }
                else {
                    importActionItem.remove();
                }
            },
            failure: function(){
                console.warn(arguments);
                importActionItem.remove();
            }
        });
    })()
</script>
#end
<!-- END templates/screens/xnat_projectData/actionsBox/pacsImport.vm -->
