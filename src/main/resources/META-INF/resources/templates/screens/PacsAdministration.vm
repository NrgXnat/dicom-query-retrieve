#* @vtlvariable name="strategies" type="java.util.Map" *#
#* @vtlvariable name="strategy" type="org.nrg.tip.dicom.strategy.orm.OrmStrategy" *#
#* @vtlvariable name="strategyEntry" type="java.util.Map.Entry" *#
#* @vtlvariable name="strategyId" type="java.lang.String" *#
#* @vtlvariable name="content" type="org.apache.turbine.services.pull.tools.ContentTool" *#
<!-- BEGIN templates/screens/PacsAdministration.vm -->
<link rel="stylesheet" type="text/css" href="https://ajax.aspnetcdn.com/ajax/jquery.dataTables/1.9.4/css/jquery.dataTables.css">
<script type="text/javascript" charset="utf8" src="https://ajax.aspnetcdn.com/ajax/jquery.dataTables/1.9.4/jquery.dataTables.min.js"></script>

<script type="text/javascript" src="$content.getURI("scripts/tip/PacsAdministration.js")"></script>
<link rel="stylesheet" type="text/css" href="$content.getURI("style/tip/PacsAdministration.css")">

<script type="text/javascript">
    jq(document).ready(function () {
        XNAT.app.PacsAdministration.init("$content.getURI("images/")");
    });
</script>

<style>
    .editRow:hover, .deleteRow:hover { background-color: #ddd; border-radius: 2px; cursor: pointer; }
</style>

<DIV class="edit_title">PACS Administration</DIV><br/>

<div id="delete_modal_content" class="modal_content" style="display:none;">
    <p>Are you sure you want to delete this PACS?</p>
</div>


<div id="edit_modal_content" class="modal_content" style="display:none;">

    <form id="editPacsForm" name="editPacsForm" class="editPacsForm">
        #if ($strategies.size() == 0)
            <b>ERROR!</b> There are no available ORM strategies. Please contact your TIP system administrator.
        #elseif($strategies.size() == 1)
            #set($strategyId = $strategies.values().iterator().next())
            <input id="ormStrategySpringBeanId" name="ormStrategySpringBeanId" type="hidden" value="$strategyId"/>
        #end
        <table>
            <tr>
                <td><label for="pacsId">ID</label></td>
                <td><input id="pacsId" name="pacsId" type="text" class="editPacs" disabled/></td>
            </tr>
            <tr>
                <td><label for="aeTitle">AE Title</label></td>
                <td><input id="aeTitle" name="aeTitle" type="text" class="editPacs"/></td>
            </tr>
            <tr>
                <td><label for="host">Host</label></td>
                <td><input id="host" name="host" type="text" class="editPacs"/></td>
            </tr>
            <tr>
                <td><label for="queryRetrievePort">Q/R Port</label></td>
                <td><input id="queryRetrievePort" name="queryRetrievePort" type="text" class="editPacs"/></td>
            </tr>
            <tr>
                <td><label for="storagePort">Storage Port</label></td>
                <td><input id="storagePort" name="storagePort" type="text" class="editPacs"/></td>
            </tr>
            <tr>
                <td><label for="extendedNegotiations">Supports Extended Negotiations?</label></td>
                <td><input id="extendedNegotiations" name="extendedNegotiations" type="checkbox" class="editPacs"/></td>
            </tr>
            #if ($strategies.size() > 1)
            <tr>
                <td><label for="ormStrategySpringBeanId">ORM Strategy</label></td>
                <td>
                    <select id="ormStrategySpringBeanId" name="ormStrategySpringBeanId">
                        #foreach($strategyEntry in $strategies)
                            #set($strategy = $strategyEntry.key)
                            #set($strategyId = $strategyEntry.value)
                            <option value="$strategyId">$strategy.name: $strategy.description</option>
                        #end
                    </select>
                </td>
            </tr>
            #end
            <tr>
                <td><label for="defaultQueryRetrievePacs">Default Q/R Pacs?</label></td>
                <td><input id="defaultQueryRetrievePacs" name="defaultQueryRetrievePacs" type="checkbox" class="editPacs"/></td>
            </tr>
            <tr>
                <td><label for="defaultStoragePacs">Default STORE Pacs?</label></td>
                <td><input id="defaultStoragePacs" name="defaultStoragePacs" type="checkbox" class="editPacs"/></td>
            </tr>
        </table>
    </form>
</div>

<div id="pacsDiv"/>

<!-- this content is displayed in the modal when clicking the "hello" button -->
<!-- END templates/screens/PacsAdministration.vm -->
