#* @vtlvariable name="projects" type="java.util.ArrayList" *#
#* @vtlvariable name="project" type="org.nrg.xdat.om.XnatProjectdata" *#
#* @vtlvariable="aes" type="java.util.ArrayList" *#
#* @vtlvariable name="pacsList" type="java.util.ArrayList" *#
#* @vtlvariable name="pacs" type="org.nrg.dqr.domain.entities.Pacs" *#
#* @vtlvariable name="content" type="org.apache.turbine.services.pull.tools.ContentTool" *#
#* @vtlvariable name="displayManager" type="org.nrg.xdat.display.DisplayManager" *#
<!-- BEGIN templates/screens/PacsSessionFinder2.vm -->

<script type="text/javascript" src="$content.getURI("scripts/dqr/PacsSeriesFinder2.js")"></script>
<script type="text/javascript" src="$content.getURI("/scripts/dqr/SpreadsheetImporter.js")"></script>

<script type="text/javascript" charset="utf8" src="https://ajax.aspnetcdn.com/ajax/jquery.dataTables/1.9.4/jquery.dataTables.min.js"></script>
<link rel="stylesheet" type="text/css" href="https://ajax.aspnetcdn.com/ajax/jquery.dataTables/1.9.4/css/jquery.dataTables.css">
<script type="text/javascript" charset="utf8" src="https://ajax.aspnetcdn.com/ajax/jquery.validate/1.10.0/jquery.validate.min.js"></script>


<h2 class="edit_title">Import Patient Study from PACS</h2>
#set($userCanImport = true)

#if($projects.size() == 1)
    #set($project = $projects.get(0))
    #if($data.getSession().getAttribute("userHelper").canEdit("xnat:subjectData/project",$project.getId()))

    #else
        #set($userCanImport = false)
    #end
#end

#if(!$userCanImport)
<div class="error">
    Sorry, but you do not have appropriate user permissions in order to perform this action. You must have edit privileges on at least one ${displayManager.getSingularDisplayNameForProject()} in order to import images from PACS
</div>
#else

##<form id="pacsSeriesFinderForm" class="optOutOfXnatDefaultFormValidation friendlyForm mini">
<form id="pacsSeriesFinderForm" class="optOutOfXnatDefaultFormValidation friendlyForm mini" enctype="multipart/form-data">
    <div class="inputWrapper horizontal" style="margin-right: 30px;">
        <h4>Set Query Connections (Required)</h4>
        <p>
            <label for="pacsId">Select DICOM AE to Query</label>
            <select id="pacsId" name="pacsId">
                <option VALUE="">(SELECT)</option>
                #foreach($currPacs in $pacsList)
                    <option VALUE="$currPacs.getId()" #if($currPacs.isDefaultQueryRetrievePacs())
                            selected="true" #end>$currPacs.getAeTitle()</option>
                #end
            </select>
        </p>
        <div id="pacsSeriesProjectSelector">
            #if($projects.size() == 1)
                #set($project = $projects.get(0))
                <p><strong>Project:</strong> ${project.name}</p>
                <input type="hidden" id="project" name="project" value="${project.id}"/>
            #else
                <label for="project" class="select_label"><b>Select ${displayManager.getSingularDisplayNameForProject()} To Import To:</b></label>
                <select id="project" id="project" name="project" style="min-width:200px;">
                    <option disabled selected>(Select Project)</option>
                    #foreach($proj in $projects)
                        #if($proj.canEdit($user))
                            <option value="$proj.getId()">$proj.getStringProperty("xnat:projectData/secondary_ID")</option>
                        #else
                            <option disabled>$proj.getStringProperty("xnat:projectData/secondary_ID")</option>
                        #end
                    #end
                </select>
            #end
        </div><br>

        <div id="pacsSeriesAeSelector">
            #if($aes.size() == 1)
                #set($ae = $aes.get(0))
                <p><strong>XNAT SCP Receiver:</strong> ${ae}</p>
                <input type="hidden" id="ae" name="ae" value="${ae}"/>
            #else
                <label for="ae" class="select_label"><b>Select XNAT SCP Receiver:</b></label>
                <select id="ae" id="ae" name="ae" style="min-width:200px;">
                    <option disabled selected>(Select AE)</option>
                    #foreach($tempAe in $aes)
                    ##                            #if($tempAe.isDefaultStorageDestination())
                    ##                                <option value="${tempAe.getAeTitle()}" selected>${tempAe.getDisplayString()}</option>
                    ##                            #else
                        <option value="${tempAe}">${tempAe}</option>
                    ##                            #end
                    #end
                </select>
            #end
        </div>
    </div>
    <div style="display: inline-block; margin-right: 60px; vertical-align: top; width: 400px;">
        <div class="inputWrapper">
            <h4>Select CSV File To Import</h4>
            <p>
                Your CSV file can contain multiple queries to the selected PACS, with each line containing a new query.
                Each query can specify a custom DICOM remapping scheme, if custom processing is enabled on your SCP receiver.
                (Each query entry in your CSV file must contain at least one search term in order for the query to be processed).
                <br><br>
                Download a CSV Template file here: <a href="https://bitbucket.org/xnatdev/dicom-query-retrieve/downloads/" target="_blank">DQR CSV Template</a>
            </p>
            <p>
                <input type="file" name="csv_to_store"/>
            </p>
            <p>
                <button class="btn primary" id="submit-csv-form">Upload File</button>
            </p>

        </div>
    </div>

</form>

#end

<!-- END templates/screens/PacsSessionFinder2.vm -->
