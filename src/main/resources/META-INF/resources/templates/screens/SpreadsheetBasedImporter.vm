##<form id="pacsSeriesFinderForm" class="optOutOfXnatDefaultFormValidation friendlyForm mini">
<form id="pacsSeriesFinderForm" class="optOutOfXnatDefaultFormValidation friendlyForm mini" enctype="multipart/form-data" method="POST" action="$link.setAction("ImportFromSpreadsheet")">
    <div class="inputWrapper horizontal" style="margin-right: 30px;">
        <h4>Configure Search (Required)</h4>
        <p>
            <label for="pacsId">Select DICOM AE to Query</label>
            <select id="pacsId" name="pacsId">
                <option VALUE="">(SELECT)</option>
                #foreach($currPacs in $pacsList)
                    <option VALUE="$currPacs.getId()" #if($currPacs.isDefaultQueryRetrievePacs())
                            selected="true" #end>$currPacs.getAeTitle()</option>
                #end
            </select>
        </p>
    </div>
    <div style="display: inline-block; margin-right: 60px; vertical-align: top; width: 400px;">
        <div class="inputWrapper">
            <h4>Select Destination for Import</h4>
            <div id="pacsSeriesProjectSelector">
                #if($projects.size() == 1)
                    #set($project = $projects.get(0))
                    <p><strong>Project:</strong> ${project.name}</p>
                    <input type="hidden" id="project" name="project" value="${project.id}"/>
                #else
                    <label for="project" class="select_label"><b>${displayManager.getSingularDisplayNameForProject()}:</b></label>
                    <select id="project" id="project" name="project" style="min-width:200px;">
                        <option disabled>(Select Project)</option>
                        #foreach($proj in $projects)
                            #if($proj.canEdit($data.getSession().getAttribute("user")))
                                <option value="$proj.getId()">$proj.getStringProperty("xnat:projectData/secondary_ID")</option>
                            #else
                                <option disabled>$proj.getStringProperty("xnat:projectData/secondary_ID")</option>
                            #end
                        #end
                    </select>
                    <script>
                        /*    jq.getJSON("/data/archive/projects?format=json&accessible=true",function(data){
                                for (i=0, j=data.ResultSet.Result.length; i<j; i++) {
                                    var opt="<option value='"+data.ResultSet.Result[i].id+"'>"+data.ResultSet.Result[i].name+"</option>";
                                    jq("#project").append(opt);
                                }
                            }); */
                    </script>
                #end
            </div>

            <div id="pacsSeriesAeSelector">
                #if($aes.size() == 1)
                    #set($ae = $aes.get(0))
                    <p><strong>AE:</strong> ${ae.getDisplayString()}</p>
                    <input type="hidden" id="ae" name="ae" value="${ae.getAeTitle()}"/>
                #else
                    <label for="ae" class="select_label"><b>AE:</b></label>
                    <select id="ae" id="ae" name="ae" style="min-width:200px;">
                        <option disabled>(Select AE)</option>
                        #foreach($tempAe in $aes)
                            #if($tempAe.isDefaultStorageDestination())
                                <option value="${tempAe.getAeTitle()}" selected>${tempAe.getDisplayString()}</option>
                            #else
                                <option value="${tempAe.getAeTitle()}">${tempAe.getDisplayString()}</option>
                            #end
                        #end
                    </select>
                #end
            </div>
        </div>
        <div class="inputWrapper">

                <TABLE>
                    <TR>
                        <TD>File</TD><TD><input type="file" name="csv_to_store"/></TD>
                    </TR>
                    <TR>
                        <TD colspan="3" align="right">&nbsp;</TD>
                    </TR>
                    <TR>
                        <TD colspan="3" align="right"><input type="submit" name="eventSubmit_doUpload" value="Upload"/></TD>
                    </TR>
                </TABLE>

        </div>
    </div>

</form>

