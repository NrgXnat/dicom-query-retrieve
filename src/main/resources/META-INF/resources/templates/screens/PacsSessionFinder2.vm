#* @vtlvariable name="projects" type="java.util.ArrayList" *#
#* @vtlvariable name="project" type="org.nrg.xdat.om.XnatProjectdata" *#
#* @vtlvariable="aes" type="java.util.ArrayList" *#
#* @vtlvariable name="pacs" type="org.nrg.dqr.domain.entities.Pacs" *#
#* @vtlvariable name="content" type="org.apache.turbine.services.pull.tools.ContentTool" *#
#* @vtlvariable name="displayManager" type="org.nrg.xdat.display.DisplayManager" *#
<!-- BEGIN templates/screens/PacsSessionFinder2.vm -->
<script>
    if (XNAT.ui.breadcrumbs.length) {
        XNAT.ui.breadcrumbs.push({
            id:    'pacsSessionFinder',
            link:  '$link.setPage("PacsSessionFinder.vm").addPathInfo("project","${projectId.getId()}")',
            label: 'Select ${displayManager.getSingularDisplayNameForImageSession()} From PACS'
        })
    }
</script>

<script type="text/javascript" src="$content.getURI("scripts/xnat/app/scanTable/selectableTableBehavior.js")"></script>
<link rel="stylesheet" href="$content.getURI("scripts/xnat/app/scanTable/scanTable.css")" />

<script type="text/javascript" src="$content.getURI("scripts/dqr/PacsSeriesFinder2.js")"></script>
<script type="text/javascript" charset="utf8" src="https://ajax.aspnetcdn.com/ajax/jquery.validate/1.10.0/jquery.validate.min.js"></script>


<script type="text/javascript">
    jq(document).ready(function () {
        if (window.pacsSeriesFinder == undefined) {
            window.pacsSeriesFinder = new PacsSeriesFinder2("$study.getStudyInstanceUid()", "pacsSeriesFinderDiv", "pacsSeriesFinderForm", "pacsSeriesFinderSubmit", "pacsSeriesFinderSelectAll", "validationErrorMessageHolder", $pacs.getId());
            window.pacsSeriesFinder.findSeries();
        }
    });

    function requestSelectedSeries() {
        var selectedSeriesControls = jq("input[name=selectedSeries]:checked");
        var project = jq("#project").val();
        var ae = jq("#ae").val();
        if (!selectedSeriesControls || selectedSeriesControls.length == 0) {
            xmodal.message('No series selected', 'You have to select at least one series before you can request that it be retrieved from the selected PACS.', 'OK');
        } else if (project == "") {
            xmodal.message('No project selected', 'You need to select a project to which the requested series can be assigned.', 'OK');
        } else {
            var selectedSeries = [];
            for (var index = 0; index < selectedSeriesControls.length; index++) {
                selectedSeries.push(selectedSeriesControls[index].value.replace(/_/g, '.'));
            }
            window.pacsSeriesFinder.requestSeries(project, selectedSeries, ae);
        }
    }
</script>

<h2 class="edit_title">Import ${displayManager.getSingularDisplayNameForImageSession()} From PACS</h2>
<p><strong>Step 2: Select Scans to Import and Request Images from PACS</strong></p>
#set($userCanImport = false)
#set($importErrorMessages = [])


## Check for enabled SCP receiver
#if($enabledScps.size() > 0)
    #set($userCanImport = true)
#else
    $importErrorMessages.add("XNAT encountered a configuration error. You must have at least one SCP Receiver enabled in order to import data from a PACS")
#end

#if(!$userCanImport)
    #foreach($errormsg in $importErrorMessages)
    <div class="error" style="margin-top: 4px;">$errormsg</div>
    #end
#else

    <form id="pacsSeriesFinderForm" class="optOutOfXnatDefaultFormValidation friendlyForm mini">
        <div style="display: inline-block; margin-right: 8%; vertical-align: top; width: 30%;">
            <div style="margin-bottom: 4em;">
                <h4>Select Destination for Import</h4>
                <input type="hidden" name="project" id="project" value="${projectId.id}" />

                <div id="pacsSeriesAeSelector" style="margin-top: 1em;">
                    #if($enabledScps.size() == 1)
                        #foreach($scp in $enabledScps)
                            <p><b>XNAT SCP Receiver:</b> ${scp.getAeTitle()}:${scp.getPort()} (Default)</p>
                            <input type="hidden" id="ae" name="ae" value="${scp.getAeTitle()}:${scp.getPort()}" data-identifier="${scp.getIdentifier()}" data-qrs-enabled="#if ($scp.getIdentifier() == "dqrClassicExtractors" || $scp.getIdentifier() == "dqrObjectIdentifier")true#end" />
                        #end
                    #else
                        <label for="ae" class="select_label"><b>Select XNAT SCP Receiver:</b></label>
                        <select id="ae" id="ae" name="ae" style="min-width:200px;">
                            <option disabled selected value="">(Select AE)</option>
                            #foreach($scp in $enabledScps)
                                <option value="${scp.getAeTitle()}:${scp.getPort()}" data-id="${scp.getId()}" data-identifier="${scp.getIdentifier()}" data-qrs-enabled="#if ($scp.getIdentifier() == "dqrClassicExtractors" || $scp.getIdentifier() == "dqrObjectIdentifier")true#end">
                                    ${scp.getAeTitle()}:${scp.getPort()} #if ($scp.getIdentifier() == "dqrClassicExtractors" || $scp.getIdentifier() == "dqrObjectIdentifier") (QRS Enabled)#end
                                </option>
                            #end
                        </select>
                        <div class="description"></div>
                    #end
                    <script>
                        jq(document).ready(function(){
                            var qrsEnabled=false, aeSelector = jq('#ae');
                            if (aeSelector.prop('type') =='hidden') {
                                if (aeSelector.data('qrs-enabled').toString() === 'true') qrsEnabled=true;
                            }
                            else {
                                aeSelector.find('option').each(function(){
                                    if (jq(this).data('qrs-enabled').toString() === 'true'){
                                        qrsEnabled = true;
                                        jq(this).prop('selected','selected');
                                    }
                                });
                            }

                            if (!qrsEnabled) jq('#pacsSeriesAeSelector').append('<br><div class="alert">Warning: None of your available SCP Receivers have QRS-enabled DICOM Object Identifiers. This may cause unexpected behavior on import. Consult your XNAT Admin.</div>');
                        })
                    </script>
                </div>
            </div>
            <div>
                <h4>$displayManager.getSingularDisplayNameForSubject() Info</h4>
                <table id="studyInfoTable" class="xnat-table condensed alt1" width="100%">
                    <tr>
                        <th>$displayManager.getSingularDisplayNameForSubject():</th>
                        <td>$!study.getPatient().getName().getLastNameCommaFirstName()</td>
                    </tr>
                    <tr>
                        <th>${displayManager.getSingularDisplayNameForImageSession()} Date:</th>
                        <td>$!study.getStudyDateFormattedAs("MM/dd/yyyy")</td>
                    </tr>
                    <tr>
                        <th>${displayManager.getSingularDisplayNameForImageSession()} ID:</th>
                        <td>$!study.getStudyId()</td>
                    </tr>
                    <tr>
                        <th>DICOM Accession Number:</th>
                        <td>$!study.getAccessionNumber()</td>
                    </tr>
                    <tr>
                        <th>${displayManager.getSingularDisplayNameForImageSession()} Description:</th>
                        <td>$!study.getStudyDescription()</td>
                    </tr>
                </table>
            </div>
        </div>

        <div style="display: inline-block; vertical-align: top; width: 60%;">
            <h4>Select Scans To Import</h4>
            <!--
            for some reason if you don't have this extra wrapper here,
            jQuery wipes out the submit button when emptying the div
            -->
            <div id="pacsSeriesFinderWrapperDiv">
                <div id="pacsSeriesFinderDiv" class="data-table-container" style="margin-bottom:15px;"/>
            </div>
            <div id="pacsSeriesFinderFooter"/>
            <a class="btn" id="cancel" name="cancel" href="$link.setPage("PacsSessionFinder.vm").addPathInfo("project","${projectId.getId()}")" style="padding-right: 1em">Retry ${displayManager.getSingularDisplayNameForImageSession()} Search</a>
            <button class="btn1" id="pacsSeriesFinderSubmit" name="pacsSeriesFinderSubmit" onclick="requestSelectedSeries(); return false;">Request Selected Series</button>
            <span id="validationErrorMessageHolder" style="color:red;"/>
        </div>

    </form>

#end

<!-- END templates/screens/PacsSessionFinder2.vm -->
