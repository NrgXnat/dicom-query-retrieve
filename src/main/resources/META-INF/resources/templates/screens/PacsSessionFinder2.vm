<script type="text/javascript" src="$content.getURI("scripts/tip/PacsSeriesFinder2.js")"></script>
## <script type="text/javascript" src="$content.getURI("scripts/tip/textFilter.js")"></script>
<script type="text/javascript" charset="utf8" src="https://ajax.aspnetcdn.com/ajax/jquery.dataTables/1.9.4/jquery.dataTables.min.js"></script>
<link rel="stylesheet" type="text/css" href="https://ajax.aspnetcdn.com/ajax/jquery.dataTables/1.9.4/css/jquery.dataTables.css">
<script type="text/javascript" charset="utf8" src="https://ajax.aspnetcdn.com/ajax/jquery.validate/1.10.0/jquery.validate.min.js"></script>

<script type="text/javascript">
    jq(document).ready(function () {
        if (window.pacsSeriesFinder == undefined) {
            window.pacsSeriesFinder = new PacsSeriesFinder2("$study.getStudyInstanceUid()", "pacsSeriesFinderDiv", "pacsSeriesFinderForm", "pacsSeriesFinderSubmit", "pacsSeriesFinderSelectAll", "validationErrorMessageHolder", $pacs.getId());
            window.pacsSeriesFinder.findSeries();
        }
    });

    function requestSelectedSeries() {
        var selectedSeriesControls = jq("input[name=selectedSeries]:checked");
        var project = jq("#project").val();
        if (!selectedSeriesControls || selectedSeriesControls.length == 0) {
            xmodal.message('No series selected', 'You have to select at least one series before you can request that it be retrieved from the selected PACS system.', 'OK');
        } else if (project == "") {
            xmodal.message('No project selected', 'You need to select a project to which the requested series can be assigned.', 'OK');
        } else {
            var selectedSeries = [];
            for (var index = 0; index < selectedSeriesControls.length; index++) {
                selectedSeries.push(selectedSeriesControls[index].value.replace(/_/g, '.'));
            }
            window.pacsSeriesFinder.requestSeries(project, selectedSeries);
        }
    }
</script>

<style type="text/css">
    table.dataTable tr.odd td.sorting_1 { background-color: #d3dfff; }
    table.dataTable tr.even td.sorting_1 { background-color: #f0f7ff; }
</style>

<h2 class="edit_title">Import Patient Study from PACS</h2>
#set($userCanImport = true)

#if($projects.size() == 1)
    #set($project = $projects.get(0))
    #if($data.getSession().getAttribute("user").canEdit("xnat:subjectData/project",$project.getId()))

    #else
        #set($userCanImport = false)
    #end
#end

#if(!$userCanImport)
    <div class="error">
        Sorry, but you do not have appropriate user permissions in order to import this scan series. You must have edit privileges on at least one study in order to import images from PACS
    </div>
#else

    <form id="pacsSeriesFinderForm" class="optOutOfXnatDefaultFormValidation friendlyForm mini">
        <fieldset>
            <div style="display: inline-block; margin-right: 60px; vertical-align: top; width: 400px;">
                <div class="inputWrapper">
                    <h4>Select Destination for Import</h4>
                    <div id="pacsSeriesProjectSelector">
                        #if($projects.size() == 1)
                            #set($project = $projects.get(0))
                            <p><strong>Project:</strong> ${project.name}</p>
                            <input type="hidden" id="project" name="project" value="${project.id}"/>
                        #else
                            <label for="project" class="select_label"><b>${displayManager.getSingularDisplayNameForProject()}:</b></label>
                            <select id="project" id="project" name="project" style="min-width:200px;">
                                <option disabled>(Select Project)</option>
                                #foreach($proj in $projects)
                                    ##if($data.getSession().getAttribute("user").canEdit($proj))
                                    ##if($proj.canEdit($data.getSession().getAttribute("user")))
                                    #if($data.getSession().getAttribute("user").canEdit("xnat:subjectData/project",$proj.getId()))
                                        <option value="$proj.getId()">$proj.getStringProperty("xnat:projectData/name")</option>
                                    #else
                                        <option disabled>$proj.getStringProperty("xnat:projectData/name")</option>
                                    #end
                                #end
                            </select>
                            <script>
                            /*    jq.getJSON("/data/archive/projects?format=json&accessible=true",function(data){
                                    for (i=0, j=data.ResultSet.Result.length; i<j; i++) {
                                        var opt="<option value='"+data.ResultSet.Result[i].id+"'>"+data.ResultSet.Result[i].name+"</option>";
                                        jq("#project").append(opt);
                                    }
                                }); */
                            </script>
                        #end
                    </div>
                </div>
                <div class="inputWrapper">
                    <h4>Patient Info</h4>
                    <table id="studyInfoTable" style="border:none;">
                        <tr>
                            <td style="font-weight:bold;">Patient:</td>
                            <td>$!study.getPatient().getName().getLastNameCommaFirstName()</td>
                        </tr>
                        <tr>
                            <td style="font-weight:bold;">Study:</td>
                            <td>$!study.getStudyDescription()</td>
                        </tr>
                        <tr>
                            <td style="font-weight:bold;">Study Date:</td>
                            <td>$!study.getStudyDateFormattedAs("MM/dd/yyyy")</td>
                        </tr>
                        <tr>
                            <td style="font-weight:bold;">Accession Number:</td>
                            <td>$!study.getAccessionNumber()</td>
                        </tr>
                        <!-- <tr>
                            <td style="font-weight:bold;">Referring Physician:</td>
                            <td>$!study.getReferringPhysicianName().getLastNameCommaFirstName()</td>
                        </tr> -->
                    </table>
                </div>
            </div>

            <div style="display: inline-block; vertical-align: top; width: 640px;">
                <!--
                for some reason if you don't have this extra wrapper here,
                jQuery wipes out the submit button when emptying the div
                -->
                <div id="pacsSeriesFinderWrapperDiv">
                    <div id="pacsSeriesFinderDiv" style="margin-bottom:15px;"/>
                </div>
                <div id="pacsSeriesFinderFooter"/>
                <button class="btn1" id="pacsSeriesFinderSubmit" name="pacsSeriesFinderSubmit" onclick="requestSelectedSeries(); return false;">Request Selected Series</button>
                <span id="validationErrorMessageHolder" style="color:red;"/>
            </div>
        </fieldset>


    </form>

